#!/usr/bin/env bash
set -e
. k-credentials.sh
. k-vars.sh
file="$k/.ChatGPT/$(date -u +%F_%H-%M-%S).md"

mkdir -p $(dirname "$file")

request=$(
  cat <<EOF
{
  "model": "gpt-3.5-turbo",
  "messages": [{"role": "user", "content": "$@"}]
}
EOF
)

cat <<EOF >$file
## ChatGPT API request

https://api.openai.com/v1/chat/completions

\`\`\`json
$request
\`\`\`

EOF

response=$(
  proxychains curl https://api.openai.com/v1/chat/completions \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    -H "Content-Type: application/json" \
    -d "$request" -sS | jq .
)

cat <<EOF >>$file
### response

\`\`\`json
$response
\`\`\`

EOF

echo "$response" | jq -r '.choices[0].message.content'
