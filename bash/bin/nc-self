#!/usr/bin/env bash

u=
c=
while getopts "uc" o; do
  case $o in
    u) u=-u;;
    c) c=-c;;
  esac
done
shift $(($OPTIND - 1))

ip=$1
port=$2

if [ -z "$1" ] || [ -z "$2" ]; then
  echo usage: nc-self [-u] 127.0.0.1 27015
  exit 1
fi

echo "sudo nc $u -vlp $port"
sudo echo
sudo nc $u -vlp $port &

sleep 0.1

if [ "$c" ]; then
  echo "echo kktest | nc -vc $u $ip $port"
  echo kktest | nc -vc $u $ip $port
else
  echo "nc -v $u $ip $port"
  nc -v $u $ip $port
fi

sleep 10 &&
echo &&
kill $! & # kill nc server, if don't answer too long

wait -n
kill $! # kill the sleep-kill process, if answered
