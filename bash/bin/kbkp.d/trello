#!/bin/bash
set -e
. k-vars.sh
. k-credentials.sh
header2 "kbkp trello"

f="$k/to-sync/backups/Trello"
df="Trello-$(date -u +%Y-%m)"
api="https://api.trello.com/1"
creds="key=$trello_api_key&token=$trello_token"

mkdir -p "$f/$df"
cd "$f/$df"

curl "$api/members/$trello_id/boards?filter=open&$creds" > boards.json &&
echo boards downloaded
jq -r '.[] | [.id,.name] | @tsv' boards.json > boards.tsv
while read -r id name; do
    curl -s "$api/boards/$id?$creds&actions=all&actions_limit=1000&cards=all&lists=all&members=all&member_fields=all&checklists=all&fields=all&labels=all" > "$name.json" &&
    echo $name downloaded &
done < boards.tsv
wait
cd -
7z a -mx9 $f/$df.7z $f/$df &&
rm -rf $f/$df
